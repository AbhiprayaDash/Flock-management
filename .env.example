NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional OpenAI-compatible provider; never use NEXT_PUBLIC for secrets
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional: server-only shared AI rating cache writer. Never expose as NEXT_PUBLIC.
# User records, auth and photos continue to use caller JWT + anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel-only keyless AI; model verified from the live Gateway catalog.
AI_GATEWAY_MODEL=google/gemini-3.5-flash-lite
# Optional Gateway API key for non-Vercel environments; never NEXT_PUBLIC.
AI_GATEWAY_API_KEY=
# Direct-provider setups must supply conservative price ceilings ($ / million tokens).
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
